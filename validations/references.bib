@ARTICLE{Doyle2025-zi,
  title     = "Absolute quantification of prokaryotes in the microbiome by {16S}
               {rRNA} {qPCR} or {ddPCR}",
  author    = "Doyle, Boryana and Reynolds, Gabriella Z M and Dvorak, Mai and
