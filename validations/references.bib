@ARTICLE{Pfeifer2024-dl,
  title       = "Phage-plasmids promote recombination and emergence of phages
                 and plasmids",
  author      = "Pfeifer, Eugen and Rocha, Eduardo P C",
  affiliation = "Institut Pasteur, Université Paris Cité, CNRS UMR3525,
