@ARTICLE{Grigson2022-xr,
  title       = "Organizing the bacterial annotation space with amino acid
                 sequence embeddings",
  author      = "Grigson, Susanna R and McKerral, Jody C and Mitchell, James G
                 and Edwards, Robert A",
